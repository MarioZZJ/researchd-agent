# researchd runtime environment (template).
# Copy to deploy/researchd.env (gitignored) and adjust. NEVER commit secrets.
# Precedence: CLI flags > env > file > defaults (researchd/config.py).

# Data root (writable). On this host only the repo workspace is writable.
RESEARCHD_DATA_DIR=/home/zhengzj22/Documents/researchd-agent/.data
RESEARCHD_DB=/home/zhengzj22/Documents/researchd-agent/.data/researchd.db

# Transport: uds (default) | tcp. EVERY mutating endpoint (UDS included)
# requires the bearer token (threat model T4 / blocker B-08).
# RESEARCHD_API__TRANSPORT=uds
RESEARCHD_API__TOKEN=change-me

# Executor (fake | reasonix | codex). reasonix/codex make REAL model calls
# (paid) — keep fake until authorized (docs/blockers.md B-01/B-03).
RESEARCHD_SCHEDULER__EXECUTOR=fake
RESEARCHD_SCHEDULER__DELIVERY=fake
RESEARCHD_SCHEDULER__MAX_PARALLEL=4

# Document projection platform (none | feishu).
RESEARCHD_DOC_PLATFORM=feishu
# Feishu app credentials of the RESEARCHD BOT (e.g. cli_aaf007476338dd2c).
# Required scopes: docx:document + docs:doc (share) + im:message:readonly /
# im:message:send_as_bot / im:chat:readonly. NEVER commit; 0600 file.
# RESEARCHD_LARK_APP_ID=cli_xxxxxxxx
# RESEARCHD_LARK_APP_SECRET=change-me

# Delivery via cc-connect (decision cards in the staging group).
# The cc-connect instance MUST run the researchd delivery patch (see
# docs/operations.md). BASE_URL is loopback HTTP or explicit HTTPS only.
RESEARCHD_SCHEDULER__DELIVERY=cc_connect
RESEARCHD_CC_CONNECT__BASE_URL=http://127.0.0.1:9820
RESEARCHD_CC_CONNECT__TOKEN=change-me
RESEARCHD_CC_CONNECT__PROJECT=researchd
# Session key of the active staging-group session (feishu:<chat>:root:<msg>)
RESEARCHD_CC_CONNECT__SESSION_KEY=feishu:oc_xxxx:root:om_xxxx
RESEARCHD_CC_CONNECT__CHAT_ID=oc_xxxx

# Logging
RESEARCHD_LOG_LEVEL=info
