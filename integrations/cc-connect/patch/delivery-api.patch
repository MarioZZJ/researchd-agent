 func (m *ManagementServer) handleProjectProviders(w http.ResponseWriter, r *http.Request, e *Engine, rest string) {
@@ -1994,3 +2104,75 @@ func (m *ManagementServer) handleSkillPresets(w http.ResponseWriter, r *http.Req
 	}
 	mgmtJSON(w, http.StatusOK, data)
 }
+
+
+// deliveryMu serializes load->send->save for the same idempotency key
+// (single-process; cross-process coordination is out of scope for the patch).
+var deliveryMu sync.Mutex
+
+// deliveriesFile is the persisted idempotency map (key -> platform message id).
+var deliveriesFile = filepath.Join(os.Getenv("HOME"), ".cc-connect", "deliveries.json")
+
+type deliveriesStore struct {
+	Entries map[string]string `json:"entries"`
+}
+
+// deliveryInFlight is the write-ahead reservation value stored before the
+// message is sent; it resolves to the final id once the send completes.
+const deliveryInFlight = "__in_flight__"
+
+func deleteDelivery(key string) error {
+	store := deliveriesStore{Entries: map[string]string{}}
+	if data, err := os.ReadFile(deliveriesFile); err == nil {
+		_ = json.Unmarshal(data, &store)
+	}
+	delete(store.Entries, key)
+	raw, err := json.Marshal(store)
+	if err != nil {
+		return err
+	}
+	if err := os.MkdirAll(filepath.Dir(deliveriesFile), 0o700); err != nil {
+		return err
+	}
+	tmp := deliveriesFile + ".tmp"
+	if err := os.WriteFile(tmp, raw, 0o600); err != nil {
+		return err
+	}
+	return os.Rename(tmp, deliveriesFile)
+}
+
+func loadDelivery(key string) (string, bool) {
+	data, err := os.ReadFile(deliveriesFile)
+	if err != nil {
+		return "", false
+	}
+	var store deliveriesStore
+	if err := json.Unmarshal(data, &store); err != nil {
+		return "", false
+	}
+	id, ok := store.Entries[key]
+	return id, ok
+}
+
+func saveDelivery(key, messageID string) error {
+	store := deliveriesStore{Entries: map[string]string{}}
+	if data, err := os.ReadFile(deliveriesFile); err == nil {
+		_ = json.Unmarshal(data, &store)
+	}
+	if store.Entries == nil {
+		store.Entries = map[string]string{}
+	}
+	store.Entries[key] = messageID
+	raw, err := json.Marshal(store)
+	if err != nil {
+		return err
+	}
+	if err := os.MkdirAll(filepath.Dir(deliveriesFile), 0o700); err != nil {
+		return err
+	}
+	tmp := deliveriesFile + ".tmp"
+	if err := os.WriteFile(tmp, raw, 0o600); err != nil {
+		return err
+	}
+	return os.Rename(tmp, deliveriesFile)
+}
diff --git a/core/management_delivery_test.go b/core/management_delivery_test.go
new file mode 100644
index 0000000..b19d9dc
--- /dev/null
+++ b/core/management_delivery_test.go
@@ -0,0 +1,58 @@
+package core
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestDeliveryIdempotencyStore(t *testing.T) {
+	dir := t.TempDir()
+	deliveriesFile = filepath.Join(dir, "deliveries.json")
+
+	if _, ok := loadDelivery("k-1"); ok {
+		t.Fatal("empty store must not contain k-1")
+	}
+	// write-ahead reservation, then final id
+	if err := saveDelivery("k-1", deliveryInFlight); err != nil {
+		t.Fatal(err)
+	}
+	if v, ok := loadDelivery("k-1"); !ok || v != deliveryInFlight {
+		t.Fatalf("reservation missing: %q %v", v, ok)
+	}
+	if err := saveDelivery("k-1", "om_123"); err != nil {
+		t.Fatal(err)
+	}
+	if v, ok := loadDelivery("k-1"); !ok || v != "om_123" {
+		t.Fatalf("final id missing: %q %v", v, ok)
+	}
+	// distinct keys stay independent
+	if err := saveDelivery("k-2", "om_456"); err != nil {
+		t.Fatal(err)
+	}
+	if v, _ := loadDelivery("k-1"); v != "om_123" {
+		t.Fatalf("k-1 clobbered: %q", v)
+	}
+	// delete (unreserve on failure path)
+	if err := deleteDelivery("k-2"); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := loadDelivery("k-2"); ok {
+		t.Fatal("deleted key must be gone")
+	}
+}
+
+func TestDeliveryStoreFileMode(t *testing.T) {
+	dir := t.TempDir()
+	deliveriesFile = filepath.Join(dir, "nested", "deliveries.json")
+	if err := saveDelivery("k", "om"); err != nil {
+		t.Fatal(err)
+	}
+	info, err := os.Stat(deliveriesFile)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if info.Mode().Perm() != 0o600 {
+		t.Fatalf("deliveries.json mode = %o, want 600", info.Mode().Perm())
+	}
+}
