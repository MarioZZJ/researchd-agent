+package core
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestDeliveryUUIDDeterministic(t *testing.T) {
+	a := deliveryUUID("outbox:key-1")
+	b := deliveryUUID("outbox:key-1")
+	c := deliveryUUID("outbox:key-2")
+	if a != b {
+		t.Fatalf("deliveryUUID not deterministic: %s != %s", a, b)
+	}
+	if a == c {
+		t.Fatal("deliveryUUID collides for different keys")
+	}
+	if len(a) != 35 || a[:3] != "rd-" {
+		t.Fatalf("unexpected uuid shape %q (want rd-<32 hex>)", a)
+	}
+	for _, ch := range a {
+		ok := ch >= 'a' && ch <= 'z' || ch >= '0' && ch <= '9' || ch == '-'
+		if !ok {
+			t.Fatalf("uuid %q contains char outside [a-z0-9-]: %q", a, ch)
+		}
+	}
+}
+
+func TestDeliveryLedgerCorruptFailsClosed(t *testing.T) {
+	dir := t.TempDir()
+	deliveriesFile = filepath.Join(dir, "deliveries.json")
+	t.Cleanup(func() { deliveriesFile = filepath.Join(os.Getenv("HOME"), ".cc-connect", "deliveries.json") })
+	if err := os.WriteFile(deliveriesFile, []byte("{not json"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := loadDelivery("k"); err == nil {
+		t.Fatal("corrupt ledger must fail closed (error), not look empty")
+	}
+	if _, ok, _ := loadDelivery("k"); ok {
+		t.Fatal("corrupt ledger must not return entries")
+	}
+}
+
+func TestDeliveryLedgerRoundTrip(t *testing.T) {
+	dir := t.TempDir()
+	deliveriesFile = filepath.Join(dir, "deliveries.json")
+	t.Cleanup(func() { deliveriesFile = filepath.Join(os.Getenv("HOME"), ".cc-connect", "deliveries.json") })
+	if err := saveDelivery("key-1", "om_abc123"); err != nil {
+		t.Fatal(err)
+	}
+	id, ok, err := loadDelivery("key-1")
+	if err != nil || !ok || id != "om_abc123" {
+		t.Fatalf("round trip failed: id=%q ok=%v err=%v", id, ok, err)
+	}
+	if _, ok, _ := loadDelivery("key-2"); ok {
+		t.Fatal("unknown key must not resolve")
+	}
+}
