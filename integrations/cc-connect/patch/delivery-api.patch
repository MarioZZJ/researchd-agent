+func (m *ManagementServer) handleProjectDeliveries(w http.ResponseWriter, r *http.Request, e *Engine, rest string) {
+	// POST /deliveries                      -> create (returns platform_message_id)
+	// PATCH /deliveries/{platform_message_id} -> update in place
+	parts := strings.SplitN(rest, "/", 2)
+	deliveryID := ""
+	if len(parts) > 0 {
+		deliveryID = parts[0]
+	}
+
+	if r.Method == http.MethodPost {
+		if deliveryID != "" {
+			mgmtError(w, http.StatusBadRequest, "POST /deliveries takes no id path")
+			return
+		}
+		var body struct {
+			SessionKey string `json:"session_key"`
+			Message    string `json:"message"`
+			IdempotencyKey string `json:"idempotency_key"`
+		}
+		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+			mgmtError(w, http.StatusBadRequest, "invalid JSON: "+err.Error())
+			return
+		}
+		if body.Message == "" {
+			mgmtError(w, http.StatusBadRequest, "message is required")
+			return
+		}
+		// idempotency: the same idempotency_key always returns the same
+		// platform_message_id (persisted across restarts). The whole
+		// load->send->save sequence is serialized per process; concurrent
+		// requests for the same key cannot double-deliver.
+		if body.IdempotencyKey != "" {
+			deliveryMu.Lock()
+			defer deliveryMu.Unlock()
+			if existing, ok := loadDelivery(body.IdempotencyKey); ok {
+				if existing == deliveryInFlight {
+					// write-ahead reservation: a previous attempt is still
+					// completing (or crashed mid-send) — retry later; the key
+					// will resolve to the final id once the send completes.
+					mgmtError(w, http.StatusConflict, "delivery in progress for idempotency key")
+					return
+				}
+				mgmtJSON(w, http.StatusOK, map[string]any{
+					"platform_message_id": existing,
+					"idempotency_key":     body.IdempotencyKey,
+					"replayed":            true,
+				})
+				return
+			}
+			// write-ahead: reserve the key BEFORE sending so a crash between
+			// send and persist can never double-deliver the same key
+			if err := saveDelivery(body.IdempotencyKey, deliveryInFlight); err != nil {
+				mgmtError(w, http.StatusInternalServerError, "reserve delivery: "+err.Error())
+				return
+			}
+		}
+		handle, err := e.SendToSessionWithHandle(body.SessionKey, body.Message)
+		if err != nil {
+			// unreserve so the key can be retried
+			if body.IdempotencyKey != "" {
+				_ = deleteDelivery(body.IdempotencyKey)
+			}
+			mgmtError(w, http.StatusInternalServerError, err.Error())
+			return
+		}
+		if body.IdempotencyKey != "" {
+			if err := saveDelivery(body.IdempotencyKey, handle); err != nil {
+				mgmtError(w, http.StatusInternalServerError, "persist delivery: "+err.Error())
+				return
+			}
+		}
+		mgmtJSON(w, http.StatusOK, map[string]any{
+			"platform_message_id": handle,
+			"idempotency_key":     body.IdempotencyKey,
+			"replayed":            false,
+		})
+		return
+	}
+
+	if r.Method == http.MethodPatch {
+		if deliveryID == "" {
+			mgmtError(w, http.StatusBadRequest, "PATCH /deliveries/{platform_message_id} requires an id")
+			return
+		}
+		var body struct {
+			SessionKey string `json:"session_key"`
+			Message    string `json:"message"`
+		}
+		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+			mgmtError(w, http.StatusBadRequest, "invalid JSON: "+err.Error())
+			return
+		}
+		if body.Message == "" {
+			mgmtError(w, http.StatusBadRequest, "message is required")
+			return
+		}
+		if err := e.UpdateMessageByIDInSession(body.SessionKey, deliveryID, body.Message); err != nil {
+			mgmtError(w, http.StatusInternalServerError, err.Error())
+			return
+		}
+		mgmtOK(w, "message updated")
+		return
+	}
+
+	mgmtError(w, http.StatusMethodNotAllowed, "POST or PATCH only")
+}
+
