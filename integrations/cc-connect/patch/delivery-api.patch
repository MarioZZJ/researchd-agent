+func (m *ManagementServer) handleProjectDeliveries(w http.ResponseWriter, r *http.Request, e *Engine, rest string) {
+	// POST /deliveries                      -> create (returns platform_message_id)
+	// PATCH /deliveries/{platform_message_id} -> update in place
+	parts := strings.SplitN(rest, "/", 2)
+	deliveryID := ""
+	if len(parts) > 0 {
+		deliveryID = parts[0]
+	}
+
+	if r.Method == http.MethodPost {
+		if deliveryID != "" {
+			mgmtError(w, http.StatusBadRequest, "POST /deliveries takes no id path")
+			return
+		}
+		var body struct {
+			SessionKey string `json:"session_key"`
+			Message    string `json:"message"`
+			IdempotencyKey string `json:"idempotency_key"`
+		}
+		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+			mgmtError(w, http.StatusBadRequest, "invalid JSON: "+err.Error())
+			return
+		}
+		if body.Message == "" {
+			mgmtError(w, http.StatusBadRequest, "message is required")
+			return
+		}
+		// idempotency: the same idempotency_key always returns the same
+		// platform_message_id. The key maps to a DETERMINISTIC platform uuid
+		// (rd-<sha256(key) prefix>), so Feishu itself de-duplicates: a crash
+		// between send and persist can never double-send, and a retry after
+		// the crash simply re-uses the uuid (the platform returns the SAME
+		// message id). The ledger (deliveries.json) is a cache only; a
+		// CORRUPT ledger fails closed (500) — it is never treated as empty.
+		var origKey string
+		if body.IdempotencyKey != "" {
+			deliveryMu.Lock()
+			defer deliveryMu.Unlock()
+			origKey = body.IdempotencyKey
+			existing, ok, err := loadDelivery(origKey)
+			if err != nil {
+				mgmtError(w, http.StatusInternalServerError, "delivery ledger unreadable (fail-closed)")
+				return
+			}
+			if ok {
+				mgmtJSON(w, http.StatusOK, map[string]any{
+					"platform_message_id": existing,
+					"idempotency_key":     origKey,
+					"replayed":            true,
+				})
+				return
+			}
+			// deterministic platform uuid derived from the key: a retry after
+			// a crash re-uses the SAME uuid, so Feishu returns the SAME
+			// message id — never a duplicate message
+			body.IdempotencyKey = deliveryUUID(origKey)
+		}
+		handle, err := e.SendToSessionWithHandle(body.SessionKey, body.Message, body.IdempotencyKey)
+		if err != nil {
+			mgmtError(w, http.StatusInternalServerError, err.Error())
+			return
+		}
+		if origKey != "" {
+			if err := saveDelivery(origKey, handle); err != nil {
+				mgmtError(w, http.StatusInternalServerError, "persist delivery: "+err.Error())
+				return
+			}
+		}
+		mgmtJSON(w, http.StatusOK, map[string]any{
+			"platform_message_id": handle,
+			"idempotency_key":     origKey,
+			"replayed":            false,
+		})
+		return
+	}
+
+	if r.Method == http.MethodPatch {
+		if deliveryID == "" {
+			mgmtError(w, http.StatusBadRequest, "PATCH /deliveries/{platform_message_id} requires an id")
+			return
+		}
+		var body struct {
+			SessionKey string `json:"session_key"`
+			Message    string `json:"message"`
+		}
+		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+			mgmtError(w, http.StatusBadRequest, "invalid JSON: "+err.Error())
+			return
+		}
+		if body.Message == "" {
+			mgmtError(w, http.StatusBadRequest, "message is required")
+			return
+		}
+		if err := e.UpdateMessageByIDInSession(body.SessionKey, deliveryID, body.Message); err != nil {
+			mgmtError(w, http.StatusInternalServerError, err.Error())
+			return
+		}
+		mgmtOK(w, "message updated")
+		return
+	}
+
+	mgmtError(w, http.StatusMethodNotAllowed, "POST or PATCH only")
+}
+
 // ── Provider endpoints ────────────────────────────────────────
 
 func (m *ManagementServer) handleProjectProviders(w http.ResponseWriter, r *http.Request, e *Engine, rest string) {
@@ -1994,3 +2104,75 @@ func (m *ManagementServer) handleSkillPresets(w http.ResponseWriter, r *http.Req
 	}
 	mgmtJSON(w, http.StatusOK, data)
 }
+
+
+// deliveryMu serializes load->send->save for the same idempotency key
+// (single-process; cross-process coordination is out of scope for the patch).
+var deliveryMu sync.Mutex
+
+// deliveriesFile is the persisted idempotency cache (key -> platform message
+// id). It is a CACHE: the real de-duplication is Feishu's native uuid
+// (deliveryUUID below), so a crash between send and persist can never
+// double-send, and a retry resolves to the same message id.
+var deliveriesFile = filepath.Join(os.Getenv("HOME"), ".cc-connect", "deliveries.json")
+
+type deliveriesStore struct {
+	Entries map[string]string `json:"entries"`
+}
+
+// deliveryUUID derives the deterministic platform uuid from an idempotency
+// key: "rd-" + hex(sha256(key))[:32]. Feishu's uuid de-duplication guarantees
+// exactly-once even across crashes and restarts.
+func deliveryUUID(key string) string {
+	sum := sha256.Sum256([]byte(key))
+	return "rd-" + hex.EncodeToString(sum[:])[:32]
+}
+
+func deleteDelivery(key string) error {
+	store := deliveriesStore{Entries: map[string]string{}}
+	if data, err := os.ReadFile(deliveriesFile); err == nil {
+		_ = json.Unmarshal(data, &store)
+	}
+	delete(store.Entries, key)
+	raw, err := json.Marshal(store)
+	if err != nil {
+		return err
+	}
+	if err := os.MkdirAll(filepath.Dir(deliveriesFile), 0o700); err != nil {
+		return err
+	}
+	tmp := deliveriesFile + ".tmp"
+	if err := os.WriteFile(tmp, raw, 0o600); err != nil {
+		return err
+	}
+	return os.Rename(tmp, deliveriesFile)
+}
+
+// loadDelivery returns (id, found, err). A CORRUPT ledger is an error (the
+// caller fails closed) — it is never silently treated as an empty file.
+func loadDelivery(key string) (string, bool, error) {
+	data, err := os.ReadFile(deliveriesFile)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return "", false, nil
+		}
+		return "", false, err
+	}
+	var store deliveriesStore
+	if err := json.Unmarshal(data, &store); err != nil {
+		return "", false, fmt.Errorf("deliveries.json corrupt: %w", err)
+	}
+	id, ok := store.Entries[key]
+	return id, ok, nil
+}
+
+func saveDelivery(key, messageID string) error {
+	store := deliveriesStore{Entries: map[string]string{}}
+	if data, err := os.ReadFile(deliveriesFile); err == nil {
+		_ = json.Unmarshal(data, &store)
+	}
+	if store.Entries == nil {
+		store.Entries = map[string]string{}
+	}
+	store.Entries[key] = messageID
+	raw, err := json.Marshal(store)
+	if err != nil {
+		return err
+	}
+	if err := os.MkdirAll(filepath.Dir(deliveriesFile), 0o700); err != nil {
+		return err
+	}
+	tmp := deliveriesFile + ".tmp"
+	if err := os.WriteFile(tmp, raw, 0o600); err != nil {
+		return err
+	}
+	return os.Rename(tmp, deliveriesFile)
+}
