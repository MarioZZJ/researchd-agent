 // SendToSession sends a message to an active session from an external caller (API/CLI).
 // If sessionKey is empty, it picks the first active session.
+// SendToSessionWithHandle sends a message and returns the platform message id
+// (used by the Delivery API so callers can update the same message in place).
+func (e *Engine) SendToSessionWithHandle(sessionKey, message string) (string, error) {
+	state, p, replyCtx, err := e.resolveOutboundSessionTarget(sessionKey, false)
+	if err != nil {
+		return "", err
+	}
+	sender, ok := p.(MessageHandleSender)
+	if !ok {
+		return "", fmt.Errorf("platform %s: %w", p.Name(), ErrNotSupported)
+	}
+	if err := e.waitOutgoing(p); err != nil {
+		return "", err
+	}
+	handle, err := sender.SendHandle(e.ctx, replyCtx, message)
+	if err != nil {
+		return "", err
+	}
+	if state != nil {
+		state.mu.Lock()
+		state.sideText = strings.TrimSpace(message)
+		state.mu.Unlock()
+	}
+	return handle, nil
+}
+
+// UpdateMessageByIDInSession updates an already-sent message using its
+// platform message id (Delivery API PATCH path).
+func (e *Engine) UpdateMessageByIDInSession(sessionKey, messageID, content string) error {
+	_, p, _, err := e.resolveOutboundSessionTarget(sessionKey, false)
+	if err != nil {
+		return err
+	}
+	updater, ok := p.(MessageUpdaterByID)
+	if !ok {
+		return fmt.Errorf("platform %s: %w", p.Name(), ErrNotSupported)
+	}
+	return updater.UpdateMessageByID(e.ctx, messageID, content)
+}
+
 func (e *Engine) SendToSession(sessionKey, message string) error {
 	return e.SendToSessionWithAttachments(sessionKey, message, nil, nil, nil, false)
