+// UpdateMessageByID implements core.MessageUpdaterByID: update an existing
+// message using only its platform message id (Delivery API PATCH path).
+func (p *Platform) UpdateMessageByID(ctx context.Context, messageID, content string) error {
+	if !p.useInteractiveCard {
+		return core.ErrNotSupported
+	}
+	cardJSON := ""
+	if isCardJSON(content) {
+		cardJSON = content
+	} else {
+		processed := content
+		if containsMarkdown(content) {
+			processed = preprocessFeishuMarkdown(content)
+		}
+		cardJSON = buildCardJSON(sanitizeMarkdownURLs(processed))
+	}
+	return p.patchCardMessage(ctx, messageID, cardJSON)
+}
