+// SendHandle implements core.MessageHandleSender: send a message and return
+// its platform message id so the caller can update it in place.
+// A full interactive card JSON (schema 2.0) is passed through verbatim so
+// decision buttons survive; plain markdown is wrapped like a normal send.
+func (p *Platform) SendHandle(ctx context.Context, rctx any, content, idempotencyKey string) (string, error) {
+	rc, ok := rctx.(replyContext)
+	if !ok {
+		return "", fmt.Errorf("%s: invalid reply context type %T", p.tag(), rctx)
+	}
+	// Always create a NEW message: the Delivery API must return a real
+	// platform message id so the sender can update it in place (the reply
+	// path cannot produce one).
+	content = p.resolveMentionsInContent(ctx, rc.chatID, content)
+	msgType, msgBody := buildReplyContent(content)
+	if isCardJSON(content) {
+		msgType = larkim.MsgTypeInteractive
+		msgBody = content
+	}
+	return p.createMessageHandle(ctx, rc.chatID, msgType, msgBody, "send", idempotencyKey)
+}
