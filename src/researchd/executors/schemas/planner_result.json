{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "researchd.planner_result.v1",
  "title": "PlannerResult",
  "description": "Planner output: propose tasks, dependencies, risks, plan revisions. NEVER message PI directly or create OPEN decisions.",
  "type": "object",
  "required": ["schema", "proposed_tasks", "risks", "plan_revisions"],
  "properties": {
    "schema": { "const": "researchd.planner_result.v1" },
    "proposed_tasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/proposed_task" }
    },
    "risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "plan_revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "body"],
        "properties": {
          "title": { "type": "string" },
          "body": { "type": "string" },
          "supersedes": { "type": ["string", "null"] }
        }
      }
    }
  },
  "$defs": {
    "proposed_task": {
      "type": "object",
      "required": ["task_id", "role", "objective", "success_criteria"],
      "properties": {
        "task_id": { "type": "string" },
        "role": { "type": "string" },
        "objective": { "type": "string" },
        "why_now": { "type": "string" },
        "inputs": { "type": "array", "items": { "type": "string" } },
        "deliverables": { "type": "array", "items": { "type": "string" } },
        "success_criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "text"],
            "properties": {
              "id": { "type": "string" },
              "text": { "type": "string" }
            }
          }
        },
        "stop_conditions": { "type": "array", "items": { "type": "string" } },
        "escalation_conditions": { "type": "array", "items": { "type": "string" } },
        "depends_on": { "type": "array", "items": { "type": "string" } },
        "budget": { "$ref": "#/$defs/budget" },
        "executor_profile": { "type": ["string", "null"] }
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_wall_seconds": { "type": ["integer", "null"] },
        "max_executor_turns": { "type": ["integer", "null"] },
        "max_model_calls": { "type": ["integer", "null"] },
        "max_parallel_workers": { "type": ["integer", "null"] }
      }
    }
  }
}
